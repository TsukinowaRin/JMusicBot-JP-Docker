{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; python3 \"$ROOT/.cursor/hooks/pre_tool_use_policy.py\""
      }
    ],
    "beforeReadFile": [
      {
        "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; python3 \"$ROOT/.cursor/hooks/pre_tool_use_policy.py\""
      }
    ]
  }
}
